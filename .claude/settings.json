{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .harness/gate/check.sh > /tmp/harness_gate.log 2>&1 && echo '[harness] gate OK' || (echo '[harness] gate FALL\u00d3 \u2014 revisa /tmp/harness_gate.log' && tail -30 /tmp/harness_gate.log)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/cjhirashi/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/cjhirashi/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.harness/gate/check.sh)",
      "Bash(.harness/gate/check.sh --*)"
    ]
  }
}