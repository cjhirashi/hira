# hira-hub/.env.example — plantilla, sin valores reales (nunca commitear
# secretos). Copia a `.env` (gitignored) y rellena valores reales antes de
# `docker compose up`. `HUB-001-walking-skeleton` T-017.
#
# Perfil único (cloud single-tenant, `E-ADR-002`). Sin `SECRET_KEY` ni
# `ADMIN_PASSWORD_HASH` (`VUL-HUB-03`) — pertenecen al Panel Admin de H1, sin
# consumidor real todavía (Constitución Art. 10, no anticipar).

# ─── Backend (`backend/core/config.py::Settings`) ─────────────────────────
# Variables requeridas: si falta alguna, el arranque se rechaza nombrando el
# campo faltante (RF-003) — sin arranque parcial.
DATABASE_URL=postgresql+asyncpg://hub:changeme@postgres:5432/hubdb
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=changeme
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Compose — PostgreSQL (servicio `postgres`) ───────────────────────────
# Deben coincidir con las credenciales embebidas en DATABASE_URL de arriba.
POSTGRES_USER=hub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hubdb
