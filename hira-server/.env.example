# hira-server/.env.example — plantilla, sin valores reales (nunca commitear
# secretos). Copia a `.env` (gitignored) y rellena valores reales antes de
# `docker compose up`. `SRV-001-walking-skeleton` T-018.
#
# Perfil único de producción (`E-ADR-001`): SIN `HIRA_DEPLOY_MODE`, sin perfil
# `studio`, sin SQLite — no reintroducir.

# ─── Backend (`backend/core/config.py::Settings`) ─────────────────────────
# Variables requeridas: si falta alguna, el arranque se rechaza nombrando el
# campo faltante (RF-003) — sin arranque parcial.
DATABASE_URL=postgresql+asyncpg://hira:changeme@postgres:5432/hiradb
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_HOST=mosquitto
MQTT_USER=hira
MQTT_PASSWORD=changeme
SECRET_KEY=changeme-min-32-caracteres-aleatorios
CORS_ORIGINS=http://localhost:5173

# Opcionales (`Settings` fija un valor por defecto si faltan):
ENVIRONMENT=development
LOG_LEVEL=INFO

# Opcionales — adaptador BACnet (`SRV-003-bacnet-adapter`): solo necesarias
# para fijar la IP/puerto local de escucha del adaptador BAC0 si el default
# de la librería no es el adecuado para el entorno; `None` es válido.
BACNET_IP=
BACNET_PORT=

# ─── Seed del primer usuario (`backend/scripts/seed_admin_user.py`) ───────
# `SRV-002-auth-rbac`, T-026 — único mecanismo de creación de usuarios de este
# sprint (`spec.md §2`). Sin valores reales aquí; nunca commitear un password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Compose — PostgreSQL/TimescaleDB (servicio `postgres`) ───────────────
# Deben coincidir con las credenciales embebidas en DATABASE_URL de arriba.
POSTGRES_USER=hira
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hiradb

# ─── Compose — Mosquitto (servicio `mosquitto`) ───────────────────────────
# MQTT_USER/MQTT_PASSWORD (arriba) también son la credencial usada para
# generar `mosquitto/password_file` (`mosquitto/generate_password_file.sh`,
# RF-006, `VUL-SRV-001`) — deben coincidir con lo que usa el `backend`.
